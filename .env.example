# Copy to .env and fill in. .env is git-ignored.
#
# DATABASE
# Local dev connects via SSH tunnel (run in another terminal):
#   ssh -L 5432:localhost:5432 root@178.104.86.251
DATABASE_URL="postgresql://bookingbay:CHANGE_ME@localhost:5432/bookingbay_dev?schema=public"

# AUTH
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://app.lvh.me:3001"
AUTH_TRUST_HOST=true

# EMAIL — pick ONE provider. With both empty the app logs mails to console.
# A) SMTP (works for Zoho, Postmark, AWS SES, Mailgun, etc.)
SMTP_HOST=""        # e.g. smtp.zoho.eu OR smtp.zoho.com
SMTP_PORT="587"     # 465 = SSL, 587 = STARTTLS
SMTP_SECURE="false" # true for 465, false for 587
SMTP_USER=""        # full email address (login)
SMTP_PASS=""        # app-password, NOT your account password
# B) Resend (alternative API-based provider)
RESEND_API_KEY=""

# Sender address used by all outgoing mail
EMAIL_FROM="BookingBay <noreply@example.com>"

# APP
NODE_ENV=development
PORT=3001
APP_URL="http://app.lvh.me:3001"
ROOT_DOMAIN="lvh.me:3001"
