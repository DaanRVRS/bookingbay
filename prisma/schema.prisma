generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth.js v5 + Prisma adapter
// https://authjs.dev/getting-started/adapters/prisma
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  isAdmin       Boolean   @default(false)

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  invitationsSent   Invitation[]    @relation("InvitedBy")
  bookingsCreated   Booking[]       @relation("BookingCreatedBy")
  passwordResets    PasswordReset[]
  notifications     Notification[]  @relation("NotificationsToUser")
  notificationsSent Notification[]  @relation("NotificationsByUser")
  interactionsLogged OrgInteraction[] @relation("InteractionByActor")
  remindersCreated   OrgReminder[]    @relation("ReminderByCreator")
  remindersAssigned  OrgReminder[]    @relation("ReminderByAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Multi-tenant core
// ----------------------------------------------------------------------------

model Organization {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  customDomain String? @unique
  industry     String?

  logoUrl          String?
  primaryColor     String?
  heroTitle        String?
  heroSubtitle     String?
  aboutText        String?
  contactEmail     String?
  contactPhone     String?
  itemDisplayStyle ItemDisplayStyle @default(GRID)

  plan               Plan      @default(STARTER)
  subscriptionId     String?
  subscriptionStatus String?
  trialEndsAt        DateTime?
  // The end of the currently paid period. Renewal must arrive on/before
  // this date — otherwise reminders fire and (after a grace window)
  // suspendedAt is set automatically.
  paidUntil          DateTime?
  // Tracks the latest reminder we sent so the cron doesn't double-mail.
  // 0 = none, 1 = 3-day, 2 = 1-day, 3 = due-today/expired
  paymentReminderStage Int     @default(0)
  // When non-null, the org is past its grace window and feature-suspended.
  suspendedAt        DateTime?

  // Platform-CRM (only used by BookingBay admins): customer pipeline status
  // + free-form tags. UI lives in /admin/organizations/[id].
  crmStatus String @default("active")
  crmTags   Json   @default("[]")

  memberships Membership[]
  invitations Invitation[]
  categories  Category[]
  items       Item[]
  bookings    Booking[]
  customers   Customer[]
  leads       Lead[]
  leadBlocks  LeadBlock[]
  auditLogs   AuditLog[]
  pages       Page[]
  reviews     Review[]
  notifications Notification[]
  crmInteractions OrgInteraction[]
  crmReminders    OrgReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paidUntil])
  @@index([crmStatus])
}

enum Plan {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum ItemDisplayStyle {
  GRID
  LIST
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(VIEWER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  VIEWER
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role         @default(VIEWER)
  token          String       @unique
  expires        DateTime
  acceptedAt     DateTime?
  invitedById    String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("InvitedBy", fields: [invitedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([organizationId, email])
  @@index([token])
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model Category {
  id             String  @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  description    String?
  imageUrl       String?
  sortOrder      Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("Subcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]   @relation("Subcategories")
  items        Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([parentId])
}

model Item {
  id             String  @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  description    String?
  imageUrl       String?

  pricePerHour Decimal? @db.Decimal(10, 2)
  pricePerDay  Decimal? @db.Decimal(10, 2)
  pricePerWeek Decimal? @db.Decimal(10, 2)
  deposit      Decimal? @db.Decimal(10, 2)

  quantity Int     @default(1)
  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id])
  bookings     Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([categoryId])
}

// ----------------------------------------------------------------------------
// Tenant-site pages (drag-and-drop builder, Pro+)
// ----------------------------------------------------------------------------

model Page {
  id             String  @id @default(cuid())
  organizationId String
  slug           String  // URL slug — unique within org. Reserved: "home" maps to "/"
  title          String
  // JSON-array of block objects validated by Zod schemas in lib/pages/blocks.ts
  blocks         Json    @default("[]")
  isPublished    Boolean @default(true)
  showInNav      Boolean @default(true)
  sortOrder      Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// ----------------------------------------------------------------------------
// CRM + bookings
// ----------------------------------------------------------------------------

model Customer {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, email])
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  itemId         String
  customerId     String
  startAt        DateTime
  endAt          DateTime
  status         BookingStatus @default(CONFIRMED)
  totalPrice     Decimal       @db.Decimal(10, 2)
  notes          String?
  createdById    String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  createdBy    User         @relation("BookingCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startAt])
  @@index([itemId, startAt, endAt])
  @@index([customerId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

// ----------------------------------------------------------------------------
// Tenant-site lead capture (MVP: contact form, no online payment)
// ----------------------------------------------------------------------------

model Lead {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String
  phone          String?
  message        String
  itemId         String?
  startAt        DateTime?
  endAt          DateTime?
  handledAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

model LeadBlock {
  id             String   @id @default(cuid())
  organizationId String
  // Either a full address ("noreply@example.com") or a domain prefixed with
  // an @ symbol ("@example.com"). All-lowercase.
  pattern        String
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pattern])
  @@index([organizationId])
}

// ----------------------------------------------------------------------------
// Notifications — one row per recipient (fan-out). Used for admin broadcasts
// to all users + future per-org system messages.
// ----------------------------------------------------------------------------

model Notification {
  id             String  @id @default(cuid())
  userId         String
  organizationId String?
  type           String   @default("broadcast")
  title          String
  body           String
  ctaUrl         String?
  ctaLabel       String?
  // The admin / system actor that sent it (for audit + display).
  createdById    String?
  readAt         DateTime?

  user        User          @relation("NotificationsToUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("NotificationsByUser", fields: [createdById], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

// ----------------------------------------------------------------------------
// Platform CRM — only used by BookingBay-internal admins to track customer
// (organization) interactions, follow-up reminders, status pipeline.
// ----------------------------------------------------------------------------

model OrgInteraction {
  id             String   @id @default(cuid())
  organizationId String
  // Which BookingBay-admin logged this interaction.
  actorUserId    String?
  // "call" | "email" | "meeting" | "note"
  type           String
  subject        String
  body           String?
  // When the interaction actually happened (separate from createdAt logging).
  occurredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("InteractionByActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, occurredAt])
}

model OrgReminder {
  id               String    @id @default(cuid())
  organizationId   String
  createdById      String?
  assignedToUserId String?
  title            String
  notes            String?
  dueAt            DateTime
  completedAt      DateTime?
  // Has the daily cron already fanned out a notification for this reminder?
  notifiedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ReminderByCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("ReminderByAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([completedAt, dueAt])
  @@index([organizationId, completedAt])
  @@index([assignedToUserId, completedAt])
}

// ----------------------------------------------------------------------------
// Reviews / testimonials — surfaced in the testimonials page-builder block
// ----------------------------------------------------------------------------

model Review {
  id             String   @id @default(cuid())
  organizationId String
  quote          String
  author         String
  role           String?
  // 0 hides stars, 1-5 shows that many filled stars
  rating         Int      @default(5)
  isPublished    Boolean  @default(true)
  sortOrder      Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isPublished, sortOrder])
}

// ----------------------------------------------------------------------------
// Audit log (lightweight)
// ----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  // Nullable for platform-level events (admin actions outside any org context)
  organizationId String?
  actorUserId    String?
  // Friendly action key — e.g. "item.create", "org.plan.change", "admin.impersonate.start"
  action         String
  // Resource type ("item", "booking", "user", "organization", "lead", ...)
  resource       String
  resourceId     String?
  // Optional context: { before, after, ip, userAgent, ... }
  metadata       Json?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
