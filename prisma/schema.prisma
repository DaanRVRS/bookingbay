generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth.js v5 + Prisma adapter
// https://authjs.dev/getting-started/adapters/prisma
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  isAdmin       Boolean   @default(false)

  // Two-factor authentication (TOTP). Secret is base32-encoded, stored
  // in plaintext (encryption-at-rest is the DB-level concern). Required
  // for admins; optional for everyone else. `twoFactorEnabledAt` is null
  // when setup hasn't been confirmed yet — secret may already be set but
  // not active. Backup codes are stored as bcrypt hashes in
  // `twoFactorBackupCodes` ({hash, usedAt}[]).
  twoFactorSecret      String?
  twoFactorEnabledAt   DateTime?
  twoFactorBackupCodes Json?

  // Lazy-fired notification when the user has been signed up for >5 min.
  // Null = nog niet gevraagd; gevuld = prompt is verstuurd (en blijft in
  // de notification-bell tot ingevuld of weggeklikt).
  feedbackRequestedAt DateTime?

  pollsCreated Poll[]         @relation("PollByCreator")
  pollVotes    PollVote[]
  feedback     UserFeedback[]

  accounts                   Account[]
  sessions                   Session[]
  memberships                Membership[]
  invitationsSent            Invitation[]           @relation("InvitedBy")
  bookingsCreated            Booking[]              @relation("BookingCreatedBy")
  passwordResets             PasswordReset[]
  notifications              Notification[]         @relation("NotificationsToUser")
  notificationsSent          Notification[]         @relation("NotificationsByUser")
  interactionsLogged         OrgInteraction[]       @relation("InteractionByActor")
  remindersCreated           OrgReminder[]          @relation("ReminderByCreator")
  remindersAssigned          OrgReminder[]          @relation("ReminderByAssignee")
  prospectsCreated           AdminProspect[]        @relation("ProspectByCreator")
  prospectsAssigned          AdminProspect[]        @relation("ProspectByOwner")
  prospectInteractionsLogged ProspectInteraction[]  @relation("ProspectInteractionByActor")
  prospectRemindersCreated   ProspectReminder[]     @relation("ProspectReminderByCreator")
  prospectRemindersAssigned  ProspectReminder[]     @relation("ProspectReminderByAssignee")
  supportTicketsCreated      SupportTicket[]        @relation("SupportTicketByCreator")
  supportTicketMessages      SupportTicketMessage[] @relation("SupportTicketMessageByAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id      String    @id @default(cuid())
  userId  String
  token   String    @unique
  expires DateTime
  usedAt  DateTime?
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Multi-tenant core
// ----------------------------------------------------------------------------

model Organization {
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique
  customDomain           String?   @unique
  // Wanneer de CNAME-check geslaagd is — pas dan serveren we de site
  // op het custom-domein (en mag Caddy een cert provisioneren).
  customDomainVerifiedAt DateTime?
  industry               String?

  logoUrl          String?
  primaryColor     String?
  heroTitle        String?
  heroSubtitle     String?
  aboutText        String?
  contactEmail     String?
  contactPhone     String?
  itemDisplayStyle ItemDisplayStyle @default(GRID)
  // Standaard openingstijden voor de hele organisatie. Null = geen
  // openingstijden ingesteld (24/7 beschikbaar). Schema: array van 7
  // entries (ma..zo) met { open, close, closed }, gevalideerd in
  // src/lib/business-hours/schemas.ts.
  businessHours    Json?

  plan                 Plan      @default(STARTER)
  // Mollie subscription state. Authoritative voor orgs die de
  // standaard SaaS-flow doorlopen hebben (via /api/billing/checkout).
  //  - "trialing"   = trial loopt, geen mandate aanwezig
  //  - "active"     = mandate + sub actief, wordt maandelijks gecharged
  //  - "past_due"   = laatste charge mislukt, Mollie probeert opnieuw
  //  - "canceled"   = gebruiker heeft cancel gevraagd; loopt tot currentPeriodEnd
  //  - "suspended"  = service uit (suspendedAt gevuld) na grace
  //  - null         = legacy org zonder Mollie sub (admin doet paidUntil handmatig)
  subscriptionStatus   String?
  // De Mollie subscription-id (sub_xxx) — null bij trial of legacy org.
  subscriptionId       String?
  // Mollie customer-id (cus_xxx). Eén keer aangemaakt, wordt hergebruikt.
  mollieCustomerId     String?   @unique
  // Geldige mandate-id (mdt_xxx) — gemaakt bij de allereerste first-payment.
  // Zonder mandate kan Mollie geen recurring charge doen.
  mollieMandateId      String?
  trialEndsAt          DateTime?
  // Wanneer Mollie de volgende charge probeert. Gevuld door webhook bij
  // payment.paid → +1 maand. Gebruikt voor "verlengt op X" UI + cancellation.
  currentPeriodEnd     DateTime?
  // True = klant heeft 'cancel' gedrukt; service loopt door tot
  // currentPeriodEnd, daarna suspendedAt.
  cancelAtPeriodEnd    Boolean   @default(false)
  // Laatste mislukte charge — UI laat dit zien in past_due state.
  lastPaymentFailedAt  DateTime?
  // Legacy: voor orgs van vóór de Mollie-migratie. Admin zet 'm handmatig
  // en de cron stuurt 3d/1d/0d reminders + suspend na grace. Nieuwe orgs
  // gebruiken currentPeriodEnd ipv hiervan.
  paidUntil            DateTime?
  // Stage van legacy paidUntil-reminder loop. 0/1/2/3.
  paymentReminderStage Int       @default(0)
  // Trial-end-reminder stage. 0/1/2/3/4.
  trialReminderStage   Int       @default(0)
  // Wanneer service uit staat (grace-period overschreden). Reads blijven
  // open, writes worden geblokt door assertOrgActive.
  suspendedAt          DateTime?

  // Platform-CRM (only used by BookingBay admins): customer pipeline status
  // + free-form tags. UI lives in /admin/organizations/[id].
  crmStatus String @default("active")
  crmTags   Json   @default("[]")

  // Tenant-side payment configuration. "Op locatie" en "Online" staan LOS
  // van elkaar — beide mogen tegelijk aan, zodat de klant in de widget
  // kiest. Online wordt afgehandeld door Mollie ÓF Stripe (één van de twee).
  acceptLocationPayment Boolean @default(true)
  // null = online uit. "MOLLIE" of "STRIPE" = welke online provider actief is.
  onlinePaymentProvider String?
  // Legacy (pre-split). Niet meer gebruikt; kolom blijft staan voor data-
  // historie. Lees/schrijf via acceptLocationPayment + onlinePaymentProvider.
  paymentProvider     String  @default("LOCATION")
  // Encrypted API-keys (AES-256-GCM). Null als niet ingesteld.
  paymentMollieKeyEnc String?
  paymentStripeKeyEnc String?
  // Optioneel webhook-secret voor Stripe (whsec_...) — Mollie heeft dit niet.
  paymentStripeWebhookSecretEnc String?

  // Publieke embed-sleutel (Stripe-stijl `pk_xxx`) waarmee externe sites de
  // boek-widget loaden. Veiliger dan de slug exposen + later revokebaar.
  publicEmbedKey String? @unique

  // Automatische review-uitvraag. Na X dagen voltooid (default 3) gaat er
  // een e-mail uit naar de klant met een link naar reviewRequestUrl
  // (Google review, Trustpilot, of de tenant's eigen review-pagina). De
  // booking-pulse cron pakt 'm op en zet reviewRequestedAt om dubbele
  // mails te voorkomen.
  reviewRequestEnabled   Boolean @default(false)
  reviewRequestUrl       String?
  reviewRequestDelayDays Int     @default(3)

  // Klant-portaal: aan/uit-toggle. Wanneer aan, kunnen klanten via een
  // magic-link in hun reminder-mail inloggen op /portal/[slug] om hun
  // eigen boekingen te zien en (binnen X uur vóór startAt) te annuleren.
  customerPortalEnabled        Boolean @default(false)
  customerPortalCancelHoursMin Int     @default(24)

  // Widget-design — alle stijl-keuzes leven server-side achter de embed-key
  // zodat externe sites alleen `<div data-bookingbay-book="pk_xxx"></div>`
  // hoeven te plakken. Wijzigingen in dashboard zijn meteen overal live.
  widgetAccent String? // null = val terug op primaryColor
  widgetWidth  String  @default("600") // "400"|"600"|"800"|"100%"
  widgetRadius Int     @default(8)
  widgetShadow Boolean @default(true)
  // Extra branding/teksten. widgetUsps = array van { text, icon } met
  // korte USP-bullets onderaan de widget (icon = sleutel uit USP_ICONS).
  // Oudere data kan nog string[] zijn → wordt tolerant geparset.
  // widgetTagline = optionele subkop onder de bedrijfsnaam.
  // widgetDefaultLocale = standaardtaal (klant kan in de widget wisselen).
  // widgetTheme = object met optionele hex-kleuren per token (bg, card,
  // border, heading, text, orgName, buttonText, itemLink) — leeg = default.
  widgetUsps          Json    @default("[]")
  widgetTagline       String?
  widgetDefaultLocale String  @default("nl")
  widgetTheme         Json    @default("{}")

  memberships            Membership[]
  invitations            Invitation[]
  categories             Category[]
  items                  Item[]
  bookings               Booking[]
  customers              Customer[]
  leads                  Lead[]
  leadBlocks             LeadBlock[]
  auditLogs              AuditLog[]
  pages                  Page[]
  reviews                Review[]
  notifications          Notification[]
  crmInteractions        OrgInteraction[]
  crmReminders           OrgReminder[]
  convertedFromProspects AdminProspect[]
  supportTickets         SupportTicket[]
  integrations           OrgIntegration[]
  calendarBlocks         CalendarBlock[]
  calendarSyncStates     CalendarSyncState[]
  paymentEvents          PaymentEvent[]
  customerPortalTokens   CustomerPortalToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paidUntil])
  @@index([crmStatus])
}

enum Plan {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum ItemDisplayStyle {
  GRID
  LIST
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(VIEWER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  VIEWER
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role         @default(VIEWER)
  token          String       @unique
  expires        DateTime
  acceptedAt     DateTime?
  invitedById    String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("InvitedBy", fields: [invitedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([organizationId, email])
  @@index([token])
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model Category {
  id             String  @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  description    String?
  imageUrl       String?
  sortOrder      Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("Subcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]   @relation("Subcategories")
  items        Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([parentId])
}

model Item {
  id             String  @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  description    String?
  imageUrl       String?

  pricePerHour Decimal? @db.Decimal(10, 2)
  pricePerDay  Decimal? @db.Decimal(10, 2)
  pricePerWeek Decimal? @db.Decimal(10, 2)
  deposit      Decimal? @db.Decimal(10, 2)

  quantity Int     @default(1)
  isActive Boolean @default(true)

  // Boek-slot configuratie. Bezoekers in de publieke widget zien start-
  // en eindtijden als dropdowns met deze stapgrootte, binnen het window.
  // 1440 = per-dag (geen tijdkeuze in widget).
  bookingIntervalMinutes Int @default(60)
  bookingWindowStartMin  Int @default(540) // 09:00
  bookingWindowEndMin    Int @default(1080) // 18:00

  // Optioneel per-item openingstijden-override. Null = gebruik org-default.
  // Zelfde shape als Organization.businessHours.
  businessHoursOverride Json?

  // Per-integratie configuratie voor dit specifieke item. Shape:
  //   { googleCalendar: { calendarId: "abc@group.calendar.google.com" } }
  // Null = volg de org-default (bv. organization's default Google Calendar).
  integrationConfig Json?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id])
  bookings       Booking[]
  calendarBlocks CalendarBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([categoryId])
}

// ----------------------------------------------------------------------------
// Tenant-site pages (drag-and-drop builder, Pro+)
// ----------------------------------------------------------------------------

model Page {
  id             String  @id @default(cuid())
  organizationId String
  slug           String // URL slug — unique within org. Reserved: "home" maps to "/"
  title          String
  // JSON-array of block objects validated by Zod schemas in lib/pages/blocks.ts
  blocks         Json    @default("[]")
  isPublished    Boolean @default(true)
  showInNav      Boolean @default(true)
  sortOrder      Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// ----------------------------------------------------------------------------
// CRM + bookings
// ----------------------------------------------------------------------------

model Customer {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, email])
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  itemId         String
  customerId     String
  startAt        DateTime
  endAt          DateTime
  status         BookingStatus @default(CONFIRMED)
  totalPrice     Decimal       @db.Decimal(10, 2)
  notes          String?
  // Nullable: bookings created via the public widget (no logged-in user)
  // have no createdBy. Internal bookings always set this.
  createdById    String?
  // Verwijzingen naar externe systemen waar deze boeking gesynced is.
  // Shape: { googleCalendar: { eventId, calendarId }, mollie: { paymentId }, ... }
  // Iedere integratie schrijft onder z'n eigen key. Null = nooit gesynced.
  externalRefs   Json?

  // Online betaal-status voor boekingen die via een tenant-payment-provider
  // (Mollie/Stripe) zijn gemaakt. Null = pay-on-location of nog niet gestart.
  paymentStatus   String? // UNPAID | PAID | EXPIRED | REFUNDED
  paymentProvider String? // mollie | stripe — welke provider gebruikt is
  // Provider-specific id (Mollie tr_xxx of Stripe cs_xxx) zodat webhooks
  // de juiste boeking kunnen vinden.
  paymentRef      String? @unique

  // Afronding: gevuld door "Op voltooid zetten" in het dashboard. Schade
  // = vinkje of er bij oplevering iets stuk/ontbrekend was; completionNotes
  // = vrij tekstveld (bv. "klein krasje bakboord"). completedAt = moment
  // van afronden (niet automatisch op endAt — eigenaar bevestigt zelf).
  completionDamage Boolean   @default(false)
  completionNotes  String?
  completedAt      DateTime?

  // Anti-dupe voor de booking-pulse cron: gezet zodra de klant de 24u-
  // voor-startAt reminder per mail heeft gekregen. Booking-pulse skipt
  // bookings waar dit al gevuld is, ook bij cron-retries / herhaalde
  // runs binnen dezelfde dag.
  customerReminderSentAt DateTime?

  // Anti-dupe voor de review-uitvraag-mail. Gezet zodra de mail uit is
  // gegaan; cron skipt bookings waar dit al gevuld is. Null = nog niet
  // gestuurd OF feature stond uit toen booking voltooide.
  reviewRequestedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  createdBy    User?        @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startAt])
  @@index([itemId, startAt, endAt])
  @@index([customerId])
  // Dashboard-overview trekt revenue van het afgelopen jaar binnen
  // (`createdAt >= now-365d`); zonder deze index = sequential scan over
  // alle bookings van de hele instance. Met (orgId, createdAt) is het
  // een range-scan binnen één tenant.
  @@index([organizationId, createdAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

// ----------------------------------------------------------------------------
// Tenant-site lead capture (MVP: contact form, no online payment)
// ----------------------------------------------------------------------------

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String
  phone          String?
  message        String
  itemId         String?
  startAt        DateTime?
  endAt          DateTime?
  handledAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

model LeadBlock {
  id             String   @id @default(cuid())
  organizationId String
  // Either a full address ("noreply@example.com") or a domain prefixed with
  // an @ symbol ("@example.com"). All-lowercase.
  pattern        String
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pattern])
  @@index([organizationId])
}

// ----------------------------------------------------------------------------
// Notifications — one row per recipient (fan-out). Used for admin broadcasts
// to all users + future per-org system messages.
// ----------------------------------------------------------------------------

model Notification {
  id             String    @id @default(cuid())
  userId         String
  organizationId String?
  type           String    @default("broadcast")
  title          String
  body           String
  ctaUrl         String?
  ctaLabel       String?
  // The admin / system actor that sent it (for audit + display).
  createdById    String?
  readAt         DateTime?

  user         User          @relation("NotificationsToUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("NotificationsByUser", fields: [createdById], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

// ----------------------------------------------------------------------------
// Platform CRM — only used by BookingBay-internal admins to track customer
// (organization) interactions, follow-up reminders, status pipeline.
// ----------------------------------------------------------------------------

model OrgInteraction {
  id             String   @id @default(cuid())
  organizationId String
  // Which BookingBay-admin logged this interaction.
  actorUserId    String?
  // "call" | "email" | "meeting" | "note"
  type           String
  subject        String
  body           String?
  // When the interaction actually happened (separate from createdAt logging).
  occurredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("InteractionByActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, occurredAt])
}

model OrgReminder {
  id               String    @id @default(cuid())
  organizationId   String
  createdById      String?
  assignedToUserId String?
  title            String
  notes            String?
  dueAt            DateTime
  completedAt      DateTime?
  // Has the daily cron already fanned out a notification for this reminder?
  notifiedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ReminderByCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("ReminderByAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([completedAt, dueAt])
  @@index([organizationId, completedAt])
  @@index([assignedToUserId, completedAt])
}

// ----------------------------------------------------------------------------
// Sales-CRM: prospects/leads die nog GEEN organisatie hebben. Wordt door
// BookingBay-admins gebruikt om de pipeline van potentiële klanten bij te
// houden voordat ze zich registreren.
// ----------------------------------------------------------------------------

model AdminProspect {
  id          String  @id @default(cuid())
  // Pipeline: lead → gecontacteerd → demo-gepland → demo-gehad → voorstel
  //                → gewonnen / verloren
  status      String  @default("lead")
  // Contact-info — geen account, dus alle velden los opgeslagen.
  name        String
  companyName String?
  email       String?
  phone       String?
  source      String? // "website" | "referral" | "cold-call" | "other"
  notes       String?
  tags        Json    @default("[]")

  createdById String?
  ownerUserId String?

  // Wanneer een prospect zich registreert wordt 'm aan een Organization
  // gekoppeld en status → "gewonnen". History blijft staan.
  convertedOrgId String?
  convertedAt    DateTime?

  createdBy    User?         @relation("ProspectByCreator", fields: [createdById], references: [id], onDelete: SetNull)
  owner        User?         @relation("ProspectByOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  convertedOrg Organization? @relation(fields: [convertedOrgId], references: [id], onDelete: SetNull)

  interactions ProspectInteraction[]
  reminders    ProspectReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([convertedOrgId])
}

model ProspectInteraction {
  id          String   @id @default(cuid())
  prospectId  String
  actorUserId String?
  type        String // "call" | "email" | "meeting" | "note"
  subject     String
  body        String?
  occurredAt  DateTime @default(now())

  prospect AdminProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  actor    User?         @relation("ProspectInteractionByActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prospectId, occurredAt])
}

model ProspectReminder {
  id               String    @id @default(cuid())
  prospectId       String
  createdById      String?
  assignedToUserId String?
  title            String
  notes            String?
  dueAt            DateTime
  completedAt      DateTime?
  notifiedAt       DateTime?

  prospect   AdminProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  createdBy  User?         @relation("ProspectReminderByCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("ProspectReminderByAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([completedAt, dueAt])
  @@index([prospectId, completedAt])
  @@index([assignedToUserId, completedAt])
}

// ----------------------------------------------------------------------------
// Reviews / testimonials — surfaced in the testimonials page-builder block
// ----------------------------------------------------------------------------

model Review {
  id             String  @id @default(cuid())
  organizationId String
  quote          String
  author         String
  role           String?
  // 0 hides stars, 1-5 shows that many filled stars
  rating         Int     @default(5)
  isPublished    Boolean @default(true)
  sortOrder      Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isPublished, sortOrder])
}

// ----------------------------------------------------------------------------
// Audit log (lightweight)
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
// Support tickets — klanten openen een ticket vanuit het dashboard, BookingBay-
// admins beantwoorden vanuit /admin/support. Beide kanten kunnen replyen tot
// de ticket is gesloten. Discord-webhook fired bij nieuwe ticket en reply.
// ----------------------------------------------------------------------------

model SupportTicket {
  id               String                @id @default(cuid())
  organizationId   String
  createdById      String?
  subject          String
  // "general" | "billing" | "bug" | "feature" | "other"
  category         String                @default("general")
  status           SupportTicketStatus   @default(OPEN)
  priority         SupportTicketPriority @default(NORMAL)
  // Bumped on every new message, used for sorting "needs attention" lists.
  lastMessageAt    DateTime              @default(now())
  // Set when the staff side last replied — used to surface "wachten op klant".
  lastStaffReplyAt DateTime?
  // Set when the user/customer side last replied — surfaces "wachten op support".
  lastUserReplyAt  DateTime?
  closedAt         DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                  @relation("SupportTicketByCreator", fields: [createdById], references: [id], onDelete: SetNull)
  messages     SupportTicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, lastMessageAt])
  @@index([status, lastMessageAt])
}

model SupportTicketMessage {
  id           String  @id @default(cuid())
  ticketId     String
  authorUserId String?
  // True wanneer de auteur een BookingBay-admin is (staff-side reply).
  // Zo kunnen we klant- vs. support-bubbels stylen zonder elke keer
  // isAdmin van de auteur op te halen.
  isStaff      Boolean @default(false)
  body         String

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportTicketMessageByAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

enum SupportTicketStatus {
  OPEN
  AWAITING_USER
  AWAITING_SUPPORT
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ----------------------------------------------------------------------------
// Community: platform-wide polls (admins ask, users vote) + user-feedback
// (signup-prompt of zelf-initiated).
// ----------------------------------------------------------------------------

model Poll {
  id            String    @id @default(cuid())
  title         String
  question      String
  // Array of strings — de keuzes. Max ~6 in UI.
  options       Json
  // True = klant mag meerdere opties aanvinken; false = single-choice.
  allowMultiple Boolean   @default(false)
  // "draft" = nog niet uitgestuurd, "open" = stemmen mogelijk,
  // "closed" = resultaten zichtbaar, geen nieuwe stemmen.
  status        String    @default("draft")
  createdById   String?
  publishedAt   DateTime?
  closedAt      DateTime?

  createdBy User?      @relation("PollByCreator", fields: [createdById], references: [id], onDelete: SetNull)
  votes     PollVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

model PollVote {
  id            String @id @default(cuid())
  pollId        String
  userId        String
  // Indices van gekozen opties — single-choice = lengte 1, multi = 1+.
  optionIndices Json

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
}

model UserFeedback {
  id      String  @id @default(cuid())
  userId  String
  // 1-5 stars. 0 = niet ingevuld (alleen tekst).
  rating  Int     @default(0)
  comment String?
  // "signup-prompt" | "voluntary" | "other"
  source  String  @default("voluntary")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@index([userId, createdAt])
}

// ----------------------------------------------------------------------------
// Koppelingen / Integrations — upsell-add-ons bovenop het maand-abbo. Catalogus
// (welke koppelingen bestaan, prijs, beschrijving, status) leeft in
// src/lib/integrations/catalog.ts — alleen de *per-org* state staat in de DB.
// integrationKey = slug uit de catalogus (bv. "google-calendar", "mollie").
// ----------------------------------------------------------------------------

enum OrgIntegrationStatus {
  // Klant heeft "ik wil dit" geklikt op een 'binnenkort'-koppeling. Wij
  // krijgen een SupportTicket. Geen billing.
  INTERESTED
  // Klant heeft op een beschikbare koppeling 'Activeer' geklikt — wacht op
  // bevestiging (OAuth-redirect, of admin-side enable). Nog geen billing.
  REQUESTED
  // Live en wordt maandelijks meegenomen op de factuur.
  ACTIVE
  // Klant zette 'm op pauze (geen sync, geen billing) — config blijft staan
  // zodat ze later weer kunnen aanzetten zonder opnieuw OAuth.
  PAUSED
  // Iets in de sync klapte (token verlopen, API down >24u) — klant moet
  // opnieuw verbinden. Billing pauzeert automatisch.
  FAILED
}

model OrgIntegration {
  id               String               @id @default(cuid())
  organizationId   String
  integrationKey   String
  status           OrgIntegrationStatus @default(REQUESTED)
  // Snapshot van de maandprijs op het moment van activeren — beschermt de
  // klant tegen prijsverhogingen van de catalogus. 0 = gratis / inbegrepen.
  monthlyPriceEuro Int                  @default(0)
  // Wanneer 'm voor het eerst op ACTIVE ging (driver van de billing-line).
  activatedAt      DateTime?
  pausedAt         DateTime?
  // Laatste succesvolle data-sync (handig voor "Laatst gesynchroniseerd").
  lastSyncAt       DateTime?
  // Reden bij FAILED — kort, surface naar dashboard ("Token verlopen").
  failureReason    String?
  // OAuth tokens, scopes, webhook-id's, etc. — varieert per koppeling.
  // Versleutel zware secrets via env-key (TODO bij OAuth-implementatie).
  config           Json?
  // Vrije notitie van de klant ("Sync alleen werkdagen") of admin ("activated handmatig na demo").
  notes            String?
  // Het support-ticket dat ontstond bij INTERESTED/REQUESTED — zo kunnen
  // we de twee threads aan elkaar koppelen.
  supportTicketId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, integrationKey])
  @@index([organizationId, status])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Bidirectionele kalender-sync. Wanneer een gebruiker een event in Google
// Calendar maakt (buiten BookingBay om), willen we die ruimte automatisch
// blokken zodat klanten 'm niet kunnen boeken. Twee tabellen:
//
//   - CalendarBlock: één rij per extern event dat een blok vormt in BookingBay.
//     Geen Booking — die hebben we al voor onze eigen, klant-gerichte boekingen.
//   - CalendarSyncState: per (org, calendarId) bewaren we de syncToken en
//     watch-channel-info voor incrementele sync en real-time push notifications.
// ----------------------------------------------------------------------------

model CalendarBlock {
  id             String  @id @default(cuid())
  organizationId String
  // Null = blokkeert *alle* items die op deze calendarId mappen. Gevuld =
  // alleen dit specifieke item is dicht. Komt door per-item agenda-mapping:
  // als item X aan calendar Y hangt, blokken events op Y enkel item X.
  itemId         String?
  // Bron-systeem ("google-calendar" voor nu — later mogelijk outlook etc.).
  source         String
  // Provider-event-id zodat we updates/deletes kunnen volgen.
  externalId     String
  calendarId     String
  startAt        DateTime
  endAt          DateTime
  // Optioneel — voor diagnostics ("Privé-blok", "Onderhoud", ...).
  summary        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([organizationId, startAt])
  @@index([itemId, startAt])
}

model CalendarSyncState {
  id               String   @id @default(cuid())
  organizationId   String
  integrationKey   String // 'google-calendar'
  calendarId       String
  // Google push notification channel. Een channel verloopt na max 7 dagen —
  // de cron renewt 'm wanneer hij <2 dagen geldigheid heeft.
  channelId        String?  @unique
  resourceId       String?
  channelExpiresAt DateTime?
  // Incremental sync token van Google. Null = volgende sync = full backfill.
  syncToken        String?
  lastPolledAt     DateTime?
  lastError        String?
  failureCount     Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, integrationKey, calendarId])
  @@index([channelExpiresAt])
}

// ----------------------------------------------------------------------------
// Mollie payment events — idempotency-log voor webhooks + audit trail van
// elke charge / refund. Een Mollie webhook stuurt alleen een payment-id;
// we slaan hier op wat we verwerkt hebben zodat we niet dubbel processen
// bij retries en de UI een charge-historie kan laten zien.
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
// Klant-portaal magic-link tokens. Klanten zonder BookingBay-account
// kunnen op /portal/[slug]/login een mail aanvragen met een eenmalige
// link; verificatie zet een session-cookie waarmee ze hun eigen
// boekingen kunnen zien/annuleren binnen het tenant-window.
// ----------------------------------------------------------------------------

model CustomerPortalToken {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  token          String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, email])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  organizationId  String
  // Mollie payment-id (tr_xxx) of subscription-id afhankelijk van eventType
  externalId      String
  // "payment.paid" | "payment.failed" | "payment.canceled" | "payment.expired"
  // | "subscription.canceled" | "checkout.first.paid"
  eventType       String
  // Bedrag in cents (Mollie levert string-floats, wij normaliseren naar int).
  amountCents     Int?
  // Snapshot van de raw Mollie payload voor diagnostiek.
  payload         Json?
  // Eventuele Mollie subscription-id waar deze payment bij hoort.
  subscriptionId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([externalId, eventType])
  @@index([organizationId, createdAt])
  @@index([subscriptionId])
}

model AuditLog {
  id             String  @id @default(cuid())
  // Nullable for platform-level events (admin actions outside any org context)
  organizationId String?
  actorUserId    String?
  // Friendly action key — e.g. "item.create", "org.plan.change", "admin.impersonate.start"
  action         String
  // Resource type ("item", "booking", "user", "organization", "lead", ...)
  resource       String
  resourceId     String?
  // Optional context: { before, after, ip, userAgent, ... }
  metadata       Json?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
